    "output": "json",
    "maxWaitForFcp": 30000,
    "maxWaitForLoad": 45000,
    "pauseAfterFcpMs": 5250,
    "pauseAfterLoadMs": 5250,
    "networkQuietThresholdMs": 5250,
    "cpuQuietThresholdMs": 5250,
    "formFactor": "mobile",
