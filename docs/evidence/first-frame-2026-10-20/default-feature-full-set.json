    "skipAboutBlank": false,
    "blankPage": "about:blank",
    "ignoreStatusCode": false,
    "locale": "en-US",
    "blockedUrlPatterns": null,
    "additionalTraceCategories": "cc,viz",
    "extraHeaders": null,
    "precomputedLanternData": null,
    "onlyAudits": null,
